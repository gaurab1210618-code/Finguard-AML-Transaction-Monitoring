# FinGuard AI Provider Configuration
# Copy this file to .env and fill in the API keys you actually use.
# NEVER commit .env or real API keys to source control.

# ------------------------------------------------------------------
# AI provider credentials
# ------------------------------------------------------------------
NVIDIA_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Provider routing
# ------------------------------------------------------------------
# FinGuard currently uses NVIDIA as the primary provider and
# Gemini as the fallback provider.
AI_PRIMARY_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=gemini

# ------------------------------------------------------------------
# Optional model overrides
# Leave blank to use the provider defaults defined in the code.
# ------------------------------------------------------------------
NVIDIA_MODEL=
GEMINI_MODEL=
